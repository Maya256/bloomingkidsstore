<script>
(function(){
  var colors=['#1b1c1c','#6e5095','#e53935','#fb8c00','#fdd835','#43a047','#1e88e5','#ec407a','#8d6e63','#ffffff'];
  var col='#6e5095', sw=document.getElementById('swatches');
  colors.forEach(function(h,i){
    var b=document.createElement('button');
    b.className='w-9 h-9 rounded-full border-2 '+(i===1?'border-primary':'border-outline-variant/50');
    b.style.background=h;
    b.onclick=function(){col=h;[].forEach.call(sw.children,function(e){e.className=e.className.replace('border-primary','border-outline-variant/50');});
      b.className=b.className.replace('border-outline-variant/50','border-primary');};
    sw.appendChild(b);
  });
  [].forEach.call(document.querySelectorAll('#art .z'),function(el){
    el.style.cursor='pointer';
    el.addEventListener('click',function(){el.setAttribute('fill',col);});
    el.addEventListener('touchstart',function(e){e.preventDefault();el.setAttribute('fill',col);},{passive:false});
  });
  document.getElementById('reset').onclick=function(){
    [].forEach.call(document.querySelectorAll('#art .z'),function(el){el.setAttribute('fill','#ffffff');});};
})();
</script>
